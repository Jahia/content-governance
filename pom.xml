<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>jahia-modules</artifactId>
        <groupId>org.jahia.modules</groupId>
        <version>8.2.0.0</version>
    </parent>
    <groupId>org.jahia.community</groupId>
    <artifactId>content-governance</artifactId>
    <name>Content Governance</name>
    <version>1.12.0-SNAPSHOT</version>
    <packaging>bundle</packaging>
    <description>One jContent drawer for content authors with three sections - Page quality (accessibility, SEO, vitals, readability, eco-design, links, AI review), GEO readiness (AI crawlers, site files, schema, BotRank citations) and Compliance (glossaries of non-authorised terms) - switched on per site and tab, with one shared LLM configuration and the GEO and compliance site dashboards.</description>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:git@github.com:Jahia/content-governance.git</connection>
        <developerConnection>scm:git:git@github.com:Jahia/content-governance.git</developerConnection>
        <url>https://github.com/Jahia/content-governance</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!-- jcontent hosts the drawer and the dashboards; graphql-dxm-provider serves the settings and
             compliance queries. robots owns the mixin the GEO robots.txt editor writes, llms the file
             the GEO llms.txt tab shows read only: optional, so Page quality and Compliance never need
             them; without them those tabs say why and every other check works. mcp-server serves the
             tools of the editorial frame to AI agents, optional too: without it the module adds no tool. -->
        <jahia-depends>default,jcontent=[3.7,4),graphql-dxm-provider,robots=optional,llms=optional,mcp-server=optional</jahia-depends>
        <jahia-module-type>module</jahia-module-type>
        <yarn.arguments>build:production</yarn.arguments>
        <!-- The 8.2 parent sets <source>11</source> on the compiler plugin: release takes precedence. -->
        <maven.compiler.release>17</maven.compiler.release>
        <!-- Read by surefire and by the front-end unit tests (yarn test): -DskipTests skips both. -->
        <skipTests>false</skipTests>
        <graphql-dxm-provider.version>3.5.1</graphql-dxm-provider.version>
        <graphql-java-annotations.version>21.1</graphql-java-annotations.version>
    </properties>

    <dependencies>
        <!-- Jahia's own classes without the ~310 libraries jahia-impl depends on; the APIs this module
             compiles against are declared below at the versions jahia-impl 8.2.0.0 uses. The parent
             declares jahia-impl too; this declaration replaces it. -->
        <dependency>
            <groupId>org.jahia.server</groupId>
            <artifactId>jahia-impl</artifactId>
            <version>8.2.0.0</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.jahia.server</groupId>
            <artifactId>jahia-api</artifactId>
            <version>8.2.0.0</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>javax.jcr</groupId>
            <artifactId>jcr</artifactId>
            <version>2.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-text</artifactId>
            <version>1.10.0</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.core</artifactId>
            <version>7.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.cmpn</artifactId>
            <version>7.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.36</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20231013</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.quartz-scheduler</groupId>
            <artifactId>quartz</artifactId>
            <version>1.8.6</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>3.1.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jahia.modules</groupId>
            <artifactId>graphql-dxm-provider</artifactId>
            <version>${graphql-dxm-provider.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.github.graphql-java</groupId>
            <artifactId>graphql-java-annotations</artifactId>
            <version>${graphql-java-annotations.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.graphql-java</groupId>
            <artifactId>graphql-java</artifactId>
            <version>21.5</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>javax.inject</groupId>
            <artifactId>javax.inject</artifactId>
            <version>1</version>
            <scope>provided</scope>
        </dependency>
        <!-- The tool SPI that the four tools of the editorial frame implement. mcp-server has no
             release yet: each merge to its main branch publishes the snapshot to the Jahia Nexus. -->
        <dependency>
            <groupId>org.jahia.modules</groupId>
            <artifactId>mcp-server</artifactId>
            <version>0.5.0-SNAPSHOT</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- The tools and the servlets of the editorial frame read and write JSON with it. Jahia
             exports it: 2.15.2 is the version of Jahia 8.2.0.0. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.15.2</version>
            <scope>provided</scope>
        </dependency>
        <!-- Embedded: the frontmatter of SKILL.md and the rule files of an import are YAML. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.2</version>
        </dependency>

        <!-- commons-text needs it at run time; Jahia exports both, so the tests alone declare it. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.21.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
        <!-- JCRNodeWrapper's signatures name commons-lang 2 types; Mockito instruments the whole hierarchy. -->
        <dependency>
            <groupId>commons-lang</groupId>
            <artifactId>commons-lang</artifactId>
            <version>2.6</version>
            <scope>test</scope>
        </dependency>
        <!-- Mockito 5 (inline mock maker by default) for the GEO classes that reach the repository
             through JCRTemplate.getInstance() and JCRSessionFactory.getInstance(): mockStatic. -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.24.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>jahia-public</id>
            <name>Jahia Public Repository</name>
            <url>https://devtools.jahia.com/nexus/content/groups/public</url>
            <releases><enabled>true</enabled><updatePolicy>never</updatePolicy></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
        <repository>
            <id>jahia-releases-archives</id>
            <name>Jahia Releases Archive</name>
            <url>https://archives-devtools.jahia.com/jahia-releases</url>
            <releases><enabled>true</enabled><updatePolicy>never</updatePolicy></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository>
            <id>jahia-thirdparty-archives</id>
            <name>Jahia Third-Party Releases Archive</name>
            <url>https://archives-devtools.jahia.com/thirdparty-releases</url>
            <releases><enabled>true</enabled><updatePolicy>never</updatePolicy></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>jahia-public</id>
            <name>Jahia Public Repository</name>
            <url>https://devtools.jahia.com/nexus/content/groups/public</url>
            <releases><enabled>true</enabled><updatePolicy>never</updatePolicy></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </pluginRepository>
        <pluginRepository>
            <id>jahia-releases-archives</id>
            <name>Jahia Releases Archive</name>
            <url>https://archives-devtools.jahia.com/jahia-releases</url>
            <releases><enabled>true</enabled><updatePolicy>never</updatePolicy></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
        <pluginRepository>
            <id>jahia-thirdparty-archives</id>
            <name>Jahia Third-Party Releases Archive</name>
            <url>https://archives-devtools.jahia.com/thirdparty-releases</url>
            <releases><enabled>true</enabled><updatePolicy>never</updatePolicy></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-Name>Content Governance</Bundle-Name>
                        <_dsannotations>*</_dsannotations>
                        <!-- The api of the editorial frame keeps the version 0.1.0 that the module
                             editorial-frame exported, so the import range of its readers still matches. -->
                        <Export-Package>
                            org.jahia.community.contentgovernance.compliance.model,
                            org.jahia.community.contentgovernance.compliance.service.spi,
                            org.jahia.pm.modules.editorialframe.api;version="0.1.0"
                        </Export-Package>
                        <!-- The skills of this module, served by the skill registry of the editorial frame. -->
                        <Jahia-Skills>skills</Jahia-Skills>
                        <Embed-Dependency>snakeyaml;scope=compile;inline=false</Embed-Dependency>
                        <!-- Named explicitly: the GraphQL packages come from graphql-dxm-provider, whose
                             transitive dependencies are excluded, so the bundle plugin would not infer them.
                             The first line keeps the parent's: the packages jahia-maven-plugin finds in the
                             JSP views (their tag libraries), which bnd cannot see; without it a view fails
                             "Unable to load tag handler class". The SPI of mcp-server is a dynamic
                             import, below. -->
                        <Import-Package>
                            ${jahia.plugin.projectPackageImport},
                            org.jahia.modules.graphql.provider.dxm,
                            org.jahia.modules.graphql.provider.dxm.osgi.annotations,
                            graphql.annotations.annotationTypes,
                            org.quartz,
                            !org.jahia.modules.mcp.spi.tool,
                            *
                        </Import-Package>
                        <!-- mcp-server may be absent, or installed after this module, and Jahia does not
                             refresh this module then: a static optional import would stay unwired. A
                             dynamic import wires when mcp-server first asks for a tool, and never
                             without mcp-server. -->
                        <DynamicImport-Package>org.jahia.modules.mcp.spi.tool;version="[0.5,1)"</DynamicImport-Package>
                    </instructions>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>src/main/resources/javascript/apps</directory>
                            <includes><include>*</include></includes>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- snakeyaml is embedded, and its own manifest imports 16 of its 21 packages. The Jahia
                 plugin copies these imports into jahia.plugin.projectPackageImport as optional ones.
                 Jahia exports some of these packages, so the bundle would load a part of snakeyaml from
                 Jahia and the rest from its embedded copy, which fails with a LinkageError. This
                 execution removes them from the property before the bundle plugin reads it. It must
                 run after the dependencies goal of the Jahia plugin, in the same phase. Keep this
                 plugin below maven-surefire-plugin: the order then holds with the profile unit-tests
                 of the parent too. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>no-snakeyaml-import</id>
                        <phase>prepare-package</phase>
                        <goals><goal>regex-property</goal></goals>
                        <configuration>
                            <name>jahia.plugin.projectPackageImport</name>
                            <value>${jahia.plugin.projectPackageImport}</value>
                            <regex>(?:^|,)\s*org\.yaml\.snakeyaml[\w.]*(?:;[\w.:-]+=(?:"[^"]*"|[^;,"]*))*</regex>
                            <replacement></replacement>
                            <failIfNoMatch>false</failIfNoMatch>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>2.0.2</version>
                <executions>
                    <execution>
                        <id>install node and yarn</id>
                        <phase>generate-resources</phase>
                        <goals><goal>install-node-and-yarn</goal></goals>
                        <configuration>
                            <nodeVersion>v22.21.0</nodeVersion>
                            <yarnVersion>v1.22.22</yarnVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>yarn install</id>
                        <phase>generate-resources</phase>
                        <goals><goal>yarn</goal></goals>
                    </execution>
                    <execution>
                        <id>yarn build</id>
                        <phase>generate-resources</phase>
                        <goals><goal>yarn</goal></goals>
                        <configuration>
                            <arguments>${yarn.arguments}</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>yarn test</id>
                        <phase>test</phase>
                        <goals><goal>yarn</goal></goals>
                        <configuration>
                            <arguments>test</arguments>
                            <skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
