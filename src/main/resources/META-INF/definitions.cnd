<jnt = 'http://www.jahia.org/jahia/nt/1.0'>
<jmix = 'http://www.jahia.org/jahia/mix/1.0'>
<mix = 'http://www.jcp.org/jcr/mix/1.0'>
<ccs = 'http://www.jahia.org/community/content-compliance-scan/nt/1.0'>
<ccsmix = 'http://www.jahia.org/community/content-compliance-scan/mix/1.0'>

// Category of the "New content" menu for the module's types. Content folders accept
// jmix:droppableContent, which is how a content rule gets created in a content folder under /sites/<site>/contents.
[ccsmix:complianceContent] > jmix:droppableContent mixin

// Replaced by a content folder of ccs:contentRule nodes. The module converts each node of this type in
// place when it starts: its terms first, which the second child definition lets in, then the glossary.
// The type stays until no site holds one, and jmix:hiddenType keeps it out of the create menu of jContent.
[ccs:glossary] > jnt:content, mix:title, jmix:list, ccsmix:complianceContent, jmix:hiddenType orderable
 - language (string, choicelist[complianceSiteLanguages]) mandatory nofulltext
 - description (string, textarea)
 + * (ccs:glossaryTerm)
 + * (ccs:contentRule)

// Replaced by ccs:contentRule, with the evaluator pattern. The module converts each node of this type in
// place when it starts. The type stays until no site holds one.
[ccs:glossaryTerm] > jnt:content, jmix:hiddenType
 - term (string) mandatory primary
 - matchMode (string, choicelist[resourceBundle]) = 'word' autocreated mandatory < 'word', 'prefix', 'anywhere'
 - reason (string, textarea)
 - alternative (string)

// A rule that the checks apply on a site. A module ships its rules as Markdown files, and the seeder
// writes one node per rule under contents/content-insights/<module>/rules. A site changes a rule on its
// node, and adds a rule of its own anywhere under contents, such as contents/content-insights/site/rules.
// Each list of a site, such as the terms of the legal team, is a folder of rules with its own permissions.
// The evaluator names what checks the rule: pattern, threshold, presence, model, or the id of a check.
[ccs:contentRule] > jnt:content, ccsmix:complianceContent
 - ruleId (string) mandatory primary nofulltext
 // Not mandatory: Jahia refuses a new mandatory property on a type that has nodes. Empty: pattern.
 - evaluator (string) = 'pattern' autocreated nofulltext
 - enabled (boolean) = 'true' autocreated
 - severity (string, choicelist[resourceBundle]) = 'moderate' autocreated mandatory < 'critical', 'serious', 'moderate', 'minor'
 // A finding of a blocking rule stops the publication of the content.
 - blocking (boolean) = 'false' autocreated
 - fixer (string, choicelist[resourceBundle]) = 'editor' autocreated < 'editor', 'developer', 'administrator'
 // What to do about a finding. For a rule of the evaluator model, the criterion that the model checks.
 - advice (string, textarea) i18n
 // The title of a finding, with one line per plural form, such as "one: {{count}} image has no text
 // alternative" and "other: {{count}} images have no text alternative".
 - title (string, textarea) i18n
 // A neutral name of what the rule checks, such as "Title length", for a list of passed and failed rules.
 - label (string) i18n
 // The limits of a rule of the evaluator threshold, in this unit, such as characters.
 - unit (string)
 - minimum (double)
 - maximum (double)
 // The pattern of a writing rule, which the evaluator pattern checks. A term that ends with * is a stem,
 // and a term that starts with * may end another word.
 - kind (string, choicelist[resourceBundle]) < 'forbidden', 'replace', 'mandatory', 'style'
 - pattern (string)
 - matchMode (string, choicelist[resourceBundle]) < 'term', 'regex'
 - replacement (string)
 // A language code such as fr. Empty: every language.
 - ruleLanguage (string)
 // The other forms of a term and of its replacement, such as the plurals "access tokens" and "jetons d'accès".
 - patternForms (string) multiple
 - replacementForms (string) multiple
 // The language of the pattern of a glossary term that the rule translates, such as en for "access token"
 // in a rule of fr. Empty: the pattern is in the language of the rule.
 - patternLanguage (string) nofulltext
 // Texts that break the rule, and texts that keep it. ai-assistant gives them to a model.
 - wrongExamples (string, textarea) multiple
 - rightExamples (string, textarea) multiple
 // Who decided the rule, such as a name or a team, and on which day.
 - owner (string)
 - decidedOn (date, datepicker)
 // The first and the last day on which the rule applies, both included. Empty: no limit.
 - validFrom (date, datepicker)
 - validUntil (date, datepicker)
 // The file an import of the editorial frame read the rule from, so that a new import of that file replaces it.
 - source (string)
 // Where the check of the rule runs. browser: the drawer runs it on the preview of the page, the server
 // never runs it and never blocks a publication on it. Empty: server.
 - runtime (string, choicelist[resourceBundle]) nofulltext < 'server', 'browser'
 // Set by the seeder on a rule that the site changed and that its module no longer ships.
 - retired (boolean)
 // The fingerprint of the values that the seeder last wrote, so that it tells a rule that the site changed.
 - seedDigest (string) hidden nofulltext
 // The ids of the subdomains of the rule, such as seo and geo.score: its findings show in each. Empty: the
 // subdomain of the prefix of the id when one is declared, else terms for the evaluator pattern. A rule whose
 // subdomains nobody declares does not run. Version 2.0.0 replaced the property domain with it.
 - subdomains (string) multiple nofulltext
 // The keys of the sites that the rule applies to, or * for all sites. The rule also needs one of its
 // subdomains and that subdomain's domain to apply to the site.
 - sites (string, choicelist[contentGovernanceSites]) = '*' autocreated multiple nofulltext

// The folder of the rules of one module, contents/content-insights/<module>/rules.
[ccs:contentRuleFolder] > jnt:contentFolder
 + * (ccs:contentRule)

// A domain of the drawer: a main tab of a panel, such as Page quality. A module ships its domains as Markdown
// files beside its rules, and the seeder writes one node per domain under
// systemsite/contents/content-insights/<module>/domains. A site adds or overrides one under its own contents.
[ccs:contentDomain] > jnt:content, ccsmix:complianceContent
 - domainId (string) mandatory primary nofulltext
 // The panel of the drawer that shows the domain: governance, or a panel of another module, such as chat.
 - panel (string) = 'governance' autocreated nofulltext
 // The place among the domains of the panel: a lower order comes first.
 - order (long)
 // The keys of the sites that the domain applies to, or * for all sites.
 - sites (string, choicelist[contentGovernanceSites]) = '*' autocreated multiple nofulltext
 // The name of the tab.
 - label (string) i18n
 // What the domain checks, for the editor.
 - help (string, textarea) i18n
 // Set by the seeder on a domain that an administrator changed and that its module no longer ships.
 - retired (boolean)
 - seedDigest (string) hidden nofulltext

// A subdomain of the drawer: a tab of a domain, such as SEO. A rule names its subdomains, and its findings
// show in each. The seeder writes them under systemsite/contents/content-insights/<module>/subdomains.
[ccs:contentSubdomain] > jnt:content, ccsmix:complianceContent
 - subdomainId (string) mandatory primary nofulltext
 // The id of the domain of the subdomain: a change moves the tab and its rules to another domain.
 - domain (string) mandatory nofulltext
 // The place among the subdomains of the domain: a lower order comes first.
 - order (long)
 // The keys of the sites that the subdomain applies to, or * for all sites.
 - sites (string, choicelist[contentGovernanceSites]) = '*' autocreated multiple nofulltext
 - label (string) i18n
 - help (string, textarea) i18n
 - retired (boolean)
 - seedDigest (string) hidden nofulltext

// The folders of the domains and the subdomains of one module, contents/content-insights/<module>/domains
// and contents/content-insights/<module>/subdomains of the system site.
[ccs:contentDomainFolder] > jnt:contentFolder
 + * (ccs:contentDomain)
 + * (ccs:contentSubdomain)
